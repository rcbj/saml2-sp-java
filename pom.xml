<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <!-- Builds both modules. library/ is com.iyasec:saml2-sp, the library alone, and
       inherits nothing from this pom. demo/ is the demo, which depends on the library and
       is never published. Keep the three versions equal to VERSION. -->
  <groupId>com.iyasec</groupId>
  <artifactId>saml2-sp-build</artifactId>
  <version>0.1.1</version>
  <packaging>pom</packaging>
  <name>saml2-sp build</name>
  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>17</maven.compiler.release>
  </properties>
  <modules>
    <module>library</module>
    <module>demo</module>
  </modules>
</project>
