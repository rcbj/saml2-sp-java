<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <!-- The demo: an HTTP app over the library. Never published. Its jar and its runtime
       dependencies (the library among them, in target/dependency) are what the image runs. -->
  <parent>
    <groupId>com.iyasec</groupId>
    <artifactId>saml2-sp-build</artifactId>
    <version>0.1.1</version>
  </parent>
  <artifactId>saml2-sp-demo</artifactId>
  <name>saml2-sp demo</name>
  <dependencies>
    <dependency>
      <groupId>com.iyasec</groupId>
      <artifactId>saml2-sp</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>6.1.3</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.16.0</version>
        <configuration>
          <release>17</release>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.6.1</version>
        <configuration>
          <!-- TrustChainTest runs scripts/ and reads demo/saml.json from the repository root. -->
          <workingDirectory>${project.basedir}/..</workingDirectory>
        </configuration>
      </plugin>
      <plugin>
        <!-- StubIdp: a test fixture this module's tests and the demo's share. It is
             compiled into the test classpaths only, never into a published jar. -->
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>3.7.0</version>
        <executions>
          <execution>
            <id>test-fixtures</id>
            <phase>generate-test-sources</phase>
            <goals><goal>add-test-source</goal></goals>
            <configuration>
              <sources><source>${project.basedir}/../library/src/test-fixtures/java</source></sources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.6.4</version>
        <configuration>
          <mainClass>com.iyasec.saml.demo.Demo</mainClass>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.11.0</version>
        <executions>
          <execution>
            <id>copy-dependencies</id>
            <phase>package</phase>
            <goals><goal>copy-dependencies</goal></goals>
            <configuration>
              <outputDirectory>${project.build.directory}/dependency</outputDirectory>
              <includeScope>runtime</includeScope>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
